# RealityCheck environment variables (example only - never commit real keys)

# --- Backend server ---
# Port the FastAPI/uvicorn server listens on
PORT=8000

# CORS origins allowed to talk to the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# --- AssemblyAI ---
# Speech-to-text + LLM Gateway + Voice Agent API key (get one at https://www.assemblyai.com/)
# Without it the app runs in SAMPLE MODE (deterministic demo call only).
ASSEMBLYAI_API_KEY=

# AssemblyAI speech-to-text base URL (leave default)
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com

# Model used for ground-truth analysis via the LLM Gateway (configurable)
# Default is gemini-2.5-flash-lite (low-latency; confirmed in the LLM Gateway catalog).
ASSEMBLYAI_LLM_MODEL=gemini-2.5-flash-lite

# Cross-provider fallback the LLM Gateway tries if the primary model fails.
# Set to an empty string to disable fallbacks.
ASSEMBLYAI_LLM_FALLBACK_MODEL=claude-sonnet-4-6

# LLM Gateway OpenAI-compatible base URL (leave default)
ASSEMBLYAI_LLM_BASE_URL=https://llm-gateway.assemblyai.com/v1

# Max output tokens for analysis completions
ASSEMBLYAI_LLM_MAX_TOKENS=6000

# --- AssemblyAI Voice Agent (Phase 3: live debrief) ---
# Base URL for minting short-lived Voice Agent tokens (leave default)
VOICE_AGENT_BASE_URL=https://agents.assemblyai.com

# WebSocket endpoint the browser connects the voice agent session to
VOICE_AGENT_WS_URL=wss://agents.assemblyai.com/v1/ws

# TTL for minted Voice Agent session tokens, in seconds
VOICE_AGENT_TOKEN_TTL_SECONDS=300

# --- Local demo storage ---
# Where processed calls are stored as JSON (relative to repo root)
CALL_STORAGE_DIR=data/demo/calls

# --- Frontend ---
# Base URL the frontend uses to reach the backend API
VITE_API_BASE_URL=http://localhost:8000